# Optional settings. Copy to .env (git-ignored) to use them; never commit .env.
# .env is loaded by src/backend/app/db.py, so the app, the seed script and check_env.py all
# read it. Real environment variables take precedence over values in .env.

# Optional: override the SQLite file location (default: src/backend/data/cph.db).
# CPH_DB_PATH=

# Optional: model for the CPH Ops Assistant. Read it in copilot_agent.py when you wire up
# the assistant (see docs/assistant-and-finale.md); leave empty to use the Copilot SDK default.
COPILOT_MODEL=

# Optional: a GitHub token for the Copilot SDK. By default the SDK uses your signed-in
# GitHub / Copilot CLI user, which is what you want at the workshop.
# GH_TOKEN=
